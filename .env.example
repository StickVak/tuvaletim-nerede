# Ana sunucu (Express) ve admin paneli sunucusu bu dosyayı okur — değerler tarayıcıya GÖNDERİLMEZ.
PORT=3001
# Oturum belirteçlerini imzalamak için uzun, rastgele bir değer girin.
# Bu örnek değer bırakılırsa sunucu güvenli bir anahtar üretip server/data/.auth-secret'e kaydeder.
AUTH_SECRET=buraya-uzun-rastgele-bir-deger-yazin

# Yönetim API'sinin ve admin panelinin tek anahtarı (en az 16 karakter).
# Örnek değer bırakılırsa yerelde rastgele üretilip server/data/.admin-key'e kaydedilir.
# Render'da: ana servis ile admin servisine AYNI değer verilmelidir (render.yaml bunu otomatik yapar).
ADMIN_SECRET_KEY=buraya-uzun-rastgele-bir-yonetici-anahtari-yazin

# Kalıcı veritabanı (Turso / libSQL). Boşsa yerel dosya: server/data/tuvaletim.db
# Render ücretsiz planında yerel disk kalıcı değildir → canlıda Turso kullanın.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Kalıcı fotoğraflar (Cloudinary). Üçü de doluysa mekan/profil fotoğrafları Cloudinary'ye yüklenir;
# boşsa server/data/photos ve server/data/avatars klasörleri kullanılır.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google ile Giriş Yap (OAuth 2.0). İkisi de doluysa giriş/kayıt ekranında buton görünür; boşsa gizlidir.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback (Google Console'da "Authorized redirect URIs"e birebir aynı eklenmeli). Boşsa APP_URL'den türetilir:
#   <APP_URL>/api/auth/google/callback   (APP_URL de boşsa isteğin adresinden)
GOOGLE_REDIRECT_URI=
# Uygulamanın herkese açık adresi, ör. https://tuvaletim-nerede.onrender.com (yerelde http://localhost:5173)
APP_URL=

# Gizlilik Politikası (/gizlilik-politikasi) ve Hizmet Şartları (/hizmet-sartlari) sayfalarındaki iletişim e-postası.
# Boşsa MAIL_FROM'daki adres kullanılır. Google OAuth onay ekranı bu sayfaları ve bir iletişim adresi ister.
CONTACT_EMAIL=

# E-posta (kayıt doğrulama kodları).
# Öncelik: BREVO_API_KEY → RESEND_API_KEY → SMTP_* → hiçbiri yoksa kod sunucu konsoluna yazılır.
# Brevo (https://www.brevo.com): SMTP & API → API Keys'ten "xkeysib-…" anahtarı. MAIL_FROM ZORUNLU ve Brevo'da
# Senders/Domains altında doğrulanmış olmalı. Brevo "Authorised IPs" kısıtı açıksa Render'da 403 verir: kapatın.
BREVO_API_KEY=
# Resend (https://resend.com): API anahtarı + doğrulanmış alan adından gönderen adres.
RESEND_API_KEY=
# SMTP (Nodemailer) — ör. Gmail için uygulama şifresi: SMTP_HOST=smtp.gmail.com SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gönderen adres ("Ad <adres>" ya da yalın adres). Brevo'da zorunlu ve doğrulanmış; Resend'de doğrulanmış alan adı;
# SMTP'de verilmezse SMTP_USER
MAIL_FROM="Tuvaletim Nerede? <noreply@alanadiniz.com>"

# Admin paneli sunucusu (admin/server.js)
ADMIN_PORT=3002
# Ana API'nin adresi (yerelde http://localhost:3001; Render'da https://<ana-servis>.onrender.com)
MAIN_API_URL=http://localhost:3001
