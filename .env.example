# Sunucu (Express) ayarları — bu değerler tarayıcıya GÖNDERİLMEZ.
PORT=3001
# Oturum belirteçlerini imzalamak için uzun, rastgele bir değer girin.
AUTH_SECRET=buraya-uzun-rastgele-bir-deger-yazin
# /admin paneli için yönetici hesabı (sunucu her açılışta bu hesabı oluşturur/günceller).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
